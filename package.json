{
	"name": "peekaboo",
	"private": true,
	"version": "0.6.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.1.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.10"
	},
	"packageManager": "yarn@4.13.0",
	"dependencies": {
		"yaml": "^2.9.0"
	},
	"description": "Self-hosted audio + video baby monitor for your go2rtc cameras",
	"license": "MIT",
	"author": "adumat",
	"repository": {
		"type": "git",
		"url": "https://github.com/adumat/peekaboo.git"
	},
	"homepage": "https://github.com/adumat/peekaboo"
}
